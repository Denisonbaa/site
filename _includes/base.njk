<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QVPQ38EVR6"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-QVPQ38EVR6');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Denison Black Alumni Association" }}</title>
  <meta name="description" content="{{ description or 'Denison Black Alumni Association — Building community, preserving legacy and advancing Black alumni philanthropy.' }}">
  <meta property="og:title" content="{{ title or 'Denison Black Alumni Association' }}">
  <meta property="og:description" content="{{ description or 'Building community, preserving legacy and advancing Black alumni philanthropy.' }}">
  <meta property="og:image" content="/og-preview.png">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="alternate" type="application/rss+xml" title="BAA Newsletter" href="/newsletter.rss">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#9B2335">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="{{ bodyClass or '' }}">

<nav>
  <div class="logo">
    <div class="logo-text">BAA <span class="logo-accent">Denison</span></div>
  </div>
  <ul>
    <!-- Built from collections.nav (see .eleventy.js) — each page below sets
         showInNav / navLabel / navOrder in its own front matter, editable
         from the CMS's "Show in Navigation" toggle on each Site Page. -->
    {% for item in collections.nav %}
    <li><a href="{{ item.url }}" {% if page.url == item.url or (item.data.navMatch and item.data.navMatch in page.url) %}class="active"{% endif %}>{{ item.data.navLabel }}</a></li>
    {% endfor %}
  </ul>
</nav>

{{ content | safe }}

<footer>
  <div>
    <div class="f-logo">Black Alumni Association — <span>Denison University</span></div>
    <div class="f-tagline">Building community, preserving legacy and advancing Black alumni philanthropy.</div>
  </div>
  <div class="social">
    <a href="#" target="_blank" rel="noopener">LinkedIn</a>
    <a href="#" target="_blank" rel="noopener">Instagram</a>
    <a href="mailto:baaDenison@denison.edu">Email</a>
    <a href="/newsletter/">Newsletter</a>
  </div>
</footer>

<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", function(user) {
      if (!user) {
        window.netlifyIdentity.on("login", function() {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
  }
</script>
</body>
</html>
