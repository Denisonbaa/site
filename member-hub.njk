        }

        .baa-cal__event-date .weekday {
          display: block;
          font-size: 0.65rem;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          color: rgba(44,44,44,0.6);
          font-family: 'Open Sans', Arial, sans-serif;
        }

        .baa-cal__event-body { flex: 1; min-width: 0; }

        .baa-cal__event-title {
          font-weight: 700;
          font-size: 0.92rem;
          margin: 0 0 0.2rem;
          color: var(--charcoal);
        }

        .baa-cal__event-meta {
          font-size: 0.78rem;
          color: rgba(44,44,44,0.7);
          margin: 0 0 0.3rem;
          display: flex;
          flex-wrap: wrap;
          gap: 0.4rem;
          align-items: center;
        }

        .baa-cal__tag {
