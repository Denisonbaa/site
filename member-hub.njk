<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-eyebrow">Denison University · Black Alumni Association</div>
  <h1 class="page-title">Member Hub</h1>
  <p class="page-subtitle">Your gateway to the BAA network</p>
</section>

<!-- LAYOUT: calendar sidebar (left) + main page content (right), in a
     contained column (not full-bleed) — chosen after two rejected attempts
     at making the sidebar coexist with edge-to-edge section backgrounds:

     1. CSS Grid with the sticky sidebar spanning every row. Grid auto-sizes
        rows to fit their tallest occupant, and folding a tall spanning
        sidebar into that sizing inflated the (mostly-empty) Action Cards
        row to match the sidebar's full height, opening a growing blank gap
        before Committees.
     2. Flexbox with each main-column section "breaking out" to full
        viewport width via negative margins. This avoided the Grid bug and
        never hid or broke any content, but a sufficiently tall calendar
        (long event descriptions) visibly painted over the dark "Get
        Involved" CTA section, since the sticky (positioned) sidebar always
        paints above static full-bleed content wherever they overlap.

     Both were fighting the actual root cause: the calendar had no height
     limit. The fix is a capped, internally-scrolling calendar card (see
     .baa-cal below) plus this contained column, which sizes the main
     column by its own content only — independent of the sidebar's height,
     with zero chance of the two ever overlapping regardless of how tall
     the calendar gets. -->
<style>
  .member-hub-layout {
    display: flex;
    align-items: flex-start;
    gap: 40px;
    padding: 0 60px;
  }

  .member-hub-sidebar {
    flex: 0 0 320px;
    position: sticky;
    top: 96px;
  }

  .member-hub-main {
    flex: 1 1 0%;
    min-width: 0;
  }

  .member-hub-main > div {
    padding-left: 0;
    padding-right: 0;
  }

  @media (max-width: 900px) {
    .member-hub-layout {
      flex-direction: column;
      padding: 0 24px;
      gap: 32px;
    }
    .member-hub-sidebar {
      flex-basis: auto;
      width: 100%;
      position: static;
    }
  }

  @media (max-width: 600px) {
    .member-hub-layout { padding: 0 16px; }
  }
</style>

<div class="member-hub-layout">

  <!-- CALENDAR SIDEBAR -->
  <aside class="member-hub-sidebar" aria-label="BAA Calendar">
    <section class="baa-cal">
      <style>
        .baa-cal {
          --crimson: #9B2335;
          --green: #078D70;
          --charcoal: #2C2C2C;
          --cream: #F9F5EE;
          --gold: #C9A84C;
          font-family: 'Open Sans', Arial, sans-serif;
          color: var(--charcoal);
          background: var(--cream);
          border: 1px solid rgba(44,44,44,0.1);
          border-radius: 8px;
          padding: 1.5rem;
          width: 100%;
          /* Cap the card's height so it can never grow past the page,
             regardless of how many events or how long their descriptions
             get — 96px matches the sidebar's sticky top offset, 40px is
             bottom breathing room, 760px is a hard ceiling on tall
             viewports. Only #baaCalContent scrolls internally (below). */
          display: flex;
          flex-direction: column;
          max-height: min(calc(100vh - 96px - 40px), 760px);
          overflow: hidden;
        }

        .baa-cal * { box-sizing: border-box; }

        .baa-cal__heading {
          font-family: 'EB Garamond', Georgia, serif;
          font-size: 1.6rem;
          color: var(--crimson);
          margin: 0 0 0.25rem;
          flex: 0 0 auto;
        }

        .baa-cal__subheading {
          margin: 0 0 1.25rem;
          font-size: 0.85rem;
          color: rgba(44,44,44,0.75);
          flex: 0 0 auto;
        }

        .baa-cal__controls {
          display: flex;
          flex-direction: column;
          gap: 0.65rem;
          margin-bottom: 1.5rem;
          flex: 0 0 auto;
        }

        .baa-cal__search {
          padding: 0.6rem 0.9rem;
          border: 1px solid rgba(44,44,44,0.25);
          border-radius: 999px;
          font-family: inherit;
          font-size: 0.9rem;
          background: #fff;
          color: var(--charcoal);
          width: 100%;
        }

        .baa-cal__search:focus {
          outline: 2px solid var(--gold);
          outline-offset: 1px;
        }

        .baa-cal__filters {
          display: flex;
          gap: 0.4rem;
          flex-wrap: wrap;
        }

        .baa-cal__filter-btn {
          font-family: inherit;
          font-size: 0.78rem;
          font-weight: 600;
          padding: 0.4rem 0.8rem;
          border-radius: 999px;
