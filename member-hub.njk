          text-align: center;
          font-size: 0.9rem;
          color: rgba(44,44,44,0.7);
        }

        .baa-cal__month-heading {
          font-family: 'EB Garamond', Georgia, serif;
          font-size: 1.15rem;
          color: var(--charcoal);
          border-bottom: 2px solid var(--gold);
          padding-bottom: 0.35rem;
          margin: 1.5rem 0 0.85rem;
        }

        .baa-cal__month-heading:first-of-type {
          margin-top: 0;
        }

        .baa-cal__event {
          display: flex;
          gap: 0.75rem;
          align-items: flex-start;
          padding: 0.85rem 0;
          border-bottom: 1px solid rgba(44,44,44,0.08);
        }

        .baa-cal__event:last-child {
          border-bottom: none;
        }

        .baa-cal__event-date {
          flex: 0 0 46px;
          text-align: center;
          font-family: 'EB Garamond', Georgia, serif;
          color: var(--crimson);
          line-height: 1.1;
        }

        .baa-cal__event-date .day {
