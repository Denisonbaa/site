          cursor: default;
          border-color: rgba(44,44,44,0.25);
          color: rgba(44,44,44,0.4);
          background: #fff;
        }

        .baa-cal__page-info {
          font-size: 0.72rem;
          color: rgba(44,44,44,0.6);
          white-space: nowrap;
        }

        #baaCalContent {
          flex: 1 1 auto;
          min-height: 0; /* required: a flex item's default min-height:auto
                             would let it grow to fit content and silently
                             defeat overflow-y:auto below */
          overflow-y: auto;
          padding-right: 0.5rem;
          margin-right: -0.5rem;
        }

        @media (max-width: 480px) {
          .baa-cal { padding: 1.25rem; }
        }
      </style>

      <h2 class="baa-cal__heading">Calendar - What's Coming Up</h2>
      <p class="baa-cal__subheading">Search or filter to find what you're looking for.</p>

      <div class="baa-cal__controls">
        <input
          type="text"
          class="baa-cal__search"
          id="baaCalSearch"
          placeholder="Search events..."
          aria-label="Search calendar events"
        />
        <div class="baa-cal__filters" role="group" aria-label="Filter by calendar">
          <button type="button" class="baa-cal__filter-btn" data-filter="all" aria-pressed="true">All</button>
          <button type="button" class="baa-cal__filter-btn" data-filter="events" aria-pressed="false">Programs & Events</button>
          <button type="button" class="baa-cal__filter-btn" data-filter="committee" aria-pressed="false">Committee</button>
        </div>
      </div>

      <div id="baaCalContent">
        <p class="baa-cal__status" id="baaCalStatus">Loading the calendar...</p>
      </div>
    </section>

    <script>
    (function () {
      // ---- CONFIG: calendar IDs, API key, and pagination size ----
      var API_KEY = 'AIzaSyDTeNuoU4V1XRA-XRFALKq7HQmn0wxIRw8';
      var CALENDARS = [
        { id: '12a51878f8c1e7eb5adc155dbfc2efad5393c5816c3941e8421b31d43c22e18f@group.calendar.google.com', source: 'events' },
        { id: '22c4724794434a71948192886e1264c6f2e860f7e68fc239cea4cb3d0fea96e8@group.calendar.google.com', source: 'committee' }
      ];
      var SOURCE_LABELS = { events: 'Programs & Events', committee: 'Committee' };
      var MAX_RESULTS_PER_CALENDAR = 50;
      var PAGE_SIZE = 5;
      // -------------------------------------------------------------

      var allEvents = [];
      var activeFilter = 'all';
      var searchTerm = '';
      var currentPage = 0;

      var statusEl = document.getElementById('baaCalStatus');
      var contentEl = document.getElementById('baaCalContent');
      var searchEl = document.getElementById('baaCalSearch');
      var filterBtns = document.querySelectorAll('.baa-cal__filter-btn');

      // Google Calendar returns all-day events as a bare "YYYY-MM-DD" date
      // (no time, no offset). new Date() parses date-only ISO strings as UTC
      // midnight, which lands on the previous calendar day for any visitor
      // west of UTC (all US timezones) — e.g. "2026-08-20" renders as the
      // 19th. Parse all-day dates as local-timezone components instead so
      // the calendar date matches what was actually entered.
      function parseEventDate(dateStr, isAllDay) {
        if (isAllDay) {
          var parts = dateStr.split('-');
          return new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
        }
        return new Date(dateStr);
      }

      function fetchCalendar(cal) {
        var timeMin = new Date().toISOString();
        var url = 'https://www.googleapis.com/calendar/v3/calendars/' +
          encodeURIComponent(cal.id) +
          '/events?key=' + API_KEY +
          '&singleEvents=true&orderBy=startTime&timeMin=' + encodeURIComponent(timeMin) +
          '&maxResults=' + MAX_RESULTS_PER_CALENDAR;

        return fetch(url)
          .then(function (res) {
            if (!res.ok) throw new Error('Calendar fetch failed: ' + res.status);
            return res.json();
          })
          .then(function (data) {
            return (data.items || []).map(function (item) {
              var startRaw = item.start && (item.start.dateTime || item.start.date);
              var isAllDay = !!(item.start && item.start.date && !item.start.dateTime);
              return {
                id: item.id,
                title: item.summary || '(Untitled event)',
                description: item.description || '',
                location: item.location || '',
                start: startRaw ? parseEventDate(startRaw, isAllDay) : null,
                allDay: isAllDay,
                source: cal.source
              };
            });
          });
      }

      function loadAll() {
        Promise.all(CALENDARS.map(fetchCalendar))
          .then(function (results) {
            allEvents = results.flat().filter(function (e) { return e.start; });
            allEvents.sort(function (a, b) { return a.start - b.start; });
            render();
          })
          .catch(function (err) {
            console.error(err);
            statusEl.textContent = "The calendar couldn't be loaded right now. Try refreshing, or check back shortly.";
            statusEl.style.display = 'block';
          });
      }

      // Google Calendar's rich-text description editor stores formatting (links,
      // bold, line breaks) as literal HTML in the API response. Render it as HTML
      // so links work, but only after stripping it down to a safe allowlist —
      // the description field is editable by anyone with edit access to the
      // calendar, not just this page's maintainer.
      var ALLOWED_TAGS = { A: 1, B: 1, STRONG: 1, I: 1, EM: 1, U: 1, BR: 1, P: 1, SPAN: 1, DIV: 1, UL: 1, OL: 1, LI: 1 };
      var ALLOWED_ATTRS = { A: ['href'] };

      function sanitizeNode(parent) {
        var node = parent.firstChild;
        while (node) {
          var next = node.nextSibling;
          if (node.nodeType === 1) {
            var tag = node.tagName;
            if (!ALLOWED_TAGS[tag]) {
              sanitizeNode(node);
              while (node.firstChild) parent.insertBefore(node.firstChild, node);
              parent.removeChild(node);
            } else {
              var allowedAttrs = ALLOWED_ATTRS[tag] || [];
              for (var i = node.attributes.length - 1; i >= 0; i--) {
                var attrName = node.attributes[i].name;
                if (allowedAttrs.indexOf(attrName) === -1) node.removeAttribute(attrName);
              }
              if (tag === 'A') {
                var href = node.getAttribute('href') || '';
                if (!/^https?:\/\//i.test(href)) {
                  node.removeAttribute('href');
                }
                node.setAttribute('target', '_blank');
                node.setAttribute('rel', 'noopener noreferrer');
              }
              sanitizeNode(node);
            }
          } else if (node.nodeType !== 3) {
            parent.removeChild(node);
          }
          node = next;
        }
      }

      function sanitizeDescriptionHTML(html) {
        var template = document.createElement('template');
        template.innerHTML = html;
        sanitizeNode(template.content);
        return template.innerHTML;
      }

      function render() {
        var filtered = allEvents.filter(function (e) {
          var matchesFilter = activeFilter === 'all' || e.source === activeFilter;
          var matchesSearch = !searchTerm ||
            e.title.toLowerCase().indexOf(searchTerm) !== -1 ||
            e.description.toLowerCase().indexOf(searchTerm) !== -1 ||
            e.location.toLowerCase().indexOf(searchTerm) !== -1;
          return matchesFilter && matchesSearch;
        });

        contentEl.innerHTML = '';

        if (allEvents.length === 0) {
          contentEl.innerHTML = '<p class="baa-cal__status">Nothing on the calendar yet. Check back soon.</p>';
          return;
        }

        if (filtered.length === 0) {
          contentEl.innerHTML = '<p class="baa-cal__status">No events match your search.</p>';
          return;
        }

        var totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
        if (currentPage > totalPages - 1) currentPage = totalPages - 1;
        if (currentPage < 0) currentPage = 0;

        var pageStart = currentPage * PAGE_SIZE;
        var pageItems = filtered.slice(pageStart, pageStart + PAGE_SIZE);

        var currentMonthKey = '';
        var listWrap = document.createElement('div');

        pageItems.forEach(function (e) {
          var monthKey = e.start.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          if (monthKey !== currentMonthKey) {
            currentMonthKey = monthKey;
            var monthHeading = document.createElement('h3');
            monthHeading.className = 'baa-cal__month-heading';
            monthHeading.textContent = monthKey;
            listWrap.appendChild(monthHeading);
          }

          var row = document.createElement('div');
          row.className = 'baa-cal__event';

          var dateBlock = document.createElement('div');
          dateBlock.className = 'baa-cal__event-date';
          dateBlock.innerHTML =
            '<span class="day">' + e.start.getDate() + '</span>' +
            '<span class="weekday">' + e.start.toLocaleDateString('en-US', { weekday: 'short' }) + '</span>';

          var body = document.createElement('div');
          body.className = 'baa-cal__event-body';

          var title = document.createElement('p');
          title.className = 'baa-cal__event-title';
          title.textContent = e.title;

          var meta = document.createElement('div');
          meta.className = 'baa-cal__event-meta';

          var tag = document.createElement('span');
          tag.className = 'baa-cal__tag baa-cal__tag--' + e.source;
          tag.textContent = SOURCE_LABELS[e.source];
          meta.appendChild(tag);

          var timeText = document.createElement('span');
          timeText.textContent = e.allDay
            ? 'All day'
            : e.start.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
          meta.appendChild(timeText);

          if (e.location) {
            var loc = document.createElement('span');
            loc.textContent = e.location;
            meta.appendChild(loc);
          }

          body.appendChild(title);
          body.appendChild(meta);

          if (e.description) {
            var desc = document.createElement('p');
            desc.className = 'baa-cal__event-desc';
            desc.innerHTML = sanitizeDescriptionHTML(e.description);
            body.appendChild(desc);
          }

          row.appendChild(dateBlock);
          row.appendChild(body);
          listWrap.appendChild(row);
        });

        contentEl.appendChild(listWrap);

        if (totalPages > 1) {
          var pagination = document.createElement('div');
          pagination.className = 'baa-cal__pagination';

          var prevBtn = document.createElement('button');
          prevBtn.type = 'button';
          prevBtn.className = 'baa-cal__page-btn';
          prevBtn.textContent = '‹ Previous';
          prevBtn.disabled = currentPage === 0;
          prevBtn.setAttribute('aria-label', 'Show previous 5 events');
          prevBtn.addEventListener('click', function () {
            currentPage -= 1;
            render();
          });

          var info = document.createElement('span');
          info.className = 'baa-cal__page-info';
          info.textContent = 'Page ' + (currentPage + 1) + ' of ' + totalPages;

          var nextBtn = document.createElement('button');
          nextBtn.type = 'button';
          nextBtn.className = 'baa-cal__page-btn';
          nextBtn.textContent = 'Next ›';
          nextBtn.disabled = currentPage === totalPages - 1;
          nextBtn.setAttribute('aria-label', 'Show next 5 events');
          nextBtn.addEventListener('click', function () {
            currentPage += 1;
            render();
          });

          pagination.appendChild(prevBtn);
          pagination.appendChild(info);
          pagination.appendChild(nextBtn);
          contentEl.appendChild(pagination);
        }
      }

      searchEl.addEventListener('input', function () {
        searchTerm = searchEl.value.trim().toLowerCase();
        currentPage = 0;
        render();
      });

      filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          filterBtns.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
          btn.setAttribute('aria-pressed', 'true');
          activeFilter = btn.getAttribute('data-filter');
          currentPage = 0;
          render();
        });
      });

      loadAll();
    })();
    </script>
  </aside>

  <!-- MAIN CONTENT -->
  <div class="member-hub-main">

